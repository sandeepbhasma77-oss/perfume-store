/* =========================
   DESIGN SYSTEM & RESET
   ========================= */

:root {
    --black: #0C0C0C;
    --dark-black: #121212;
    --card-black: #171716;
    --panel: rgba(26, 26, 24, 0.82);
    --gold: #D4AF37;
    --gold-soft: #E7D29A;
    --light-gold: #F2E7BE;
    --ivory: #F7F3EE;
    --beige: #CDBA9B;
    --white: #FFFFFF;
    --light-gray: #D9D2C7;
    --muted: #9A948E;
    --dark-gray: #262521;
    --line: rgba(212, 175, 55, 0.2);
    --shadow-soft: 0 18px 45px rgba(0, 0, 0, 0.26);
    --shadow-gold: 0 18px 40px rgba(212, 175, 55, 0.16);
    --font-heading: 'Playfair Display', serif;
    --font-body: 'Poppins', sans-serif;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: var(--font-body);
    background: var(--black);
    color: var(--white);
    line-height: 1.6;
    overflow-x: hidden;
    position: relative;
}

body::before {
    content: ;
 position: fixed;
 inset: 0;
 background-image: radial-gradient(rgba(255,255,255,0.06) 0.6px, transparent 0.6px);
 background-size: 14px 14px;
 opacity: 0.14;
 pointer-events: none;
 z-index: 0;
}

::selection {
 background: rgba(212, 175, 55, 0.35);
 color: var(--white);
}

a {
 text-decoration: none;
 color: inherit;
 transition: 0.3s ease;
}

img {
 max-width: 100%;
 display: block;
}

ul {
 list-style: none;
}

/* =========================
 TYPOGRAPHY
 ========================= */

h1, h2, h3, h4, h5, h6 {
 font-family: var(--font-heading);
 font-weight: 700;
 line-height: 1.2;
}

h1 { font-size: clamp(48px, 6vw, 78px); }
h2 { font-size: clamp(32px, 4vw, 48px); }
h3 { font-size: clamp(20px, 2.5vw, 28px); }
h4 { font-size: clamp(18px, 2vw, 22px); }

p {
 color: var(--light-gray);
 font-weight: 300;
}

/* =========================
 BUTTONS
 ========================= */

.btn {
 display: inline-block;
 background: linear-gradient(135deg, var(--gold) 0%, var(--light-gold) 100%);
 color: var(--black);
 padding: 14px 36px;
 border: none;
 border-radius: 30px;
 font-family: var(--font-body);
 font-weight: 600;
 font-size: 14px;
 letter-spacing: 1px;
 cursor: pointer;
 transition: all 0.3s ease;
 text-transform: uppercase;
 position: relative;
 overflow: hidden;
 box-shadow: 0 10px 24px rgba(212, 175, 55, 0.22);
}

.btn::before {
 content: ;
    position: absolute;
    inset: 0;
    background: linear-gradient(120deg, transparent 10%, rgba(255,255,255,0.35) 50%, transparent 90%);
    transform: translateX(-120%);
    transition: transform 0.7s ease;
}

.btn:hover::before {
    transform: translateX(120%);
}

.btn:hover {
    transform: translateY(-2px) scale(1.01);
    box-shadow: 0 12px 28px rgba(212, 175, 55, 0.32);
}

.btn-outline {
    background: transparent;
    color: var(--gold);
    border: 1px solid rgba(212, 175, 55, 0.7);
    box-shadow: none;
}

.btn-outline:hover {
    background: rgba(212, 175, 55, 0.08);
    color: var(--light-gold);
}

/* =========================
   PRELOADER
   ========================= */

.preloader {
    position: fixed;
    inset: 0;
    background: var(--black);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10000;
    opacity: 1;
    visibility: visible;
    transition: opacity 0.8s ease, visibility 0.8s ease;
}

.preloader.hidden {
    opacity: 0;
    visibility: hidden;
}

.preloader-inner {
    text-align: center;
    color: var(--white);
}

.preloader-brand {
    font-family: var(--font-heading);
    color: var(--gold);
    font-size: clamp(2.2rem, 5vw, 4.2rem);
    letter-spacing: 0.22em;
    margin-bottom: 12px;
}

.preloader-subtitle {
    font-size: 0.75rem;
    letter-spacing: 0.55rem;
    color: var(--light-gray);
    text-transform: uppercase;
    margin-bottom: 20px;
}

.preloader-line {
    width: min(320px, 68vw);
    height: 1px;
    background: rgba(255,255,255,0.14);
    margin: 0 auto;
    position: relative;
    overflow: hidden;
}

.preloader-line span {
    position: absolute;
    inset: 0 auto 0 0;
    width: 36%;
    background: linear-gradient(90deg, rgba(212,175,55,0), var(--gold), rgba(212,175,55,0));
    animation: preloaderMove 2s ease-in-out infinite;
}

@keyframes preloaderMove {
    0% { transform: translateX(-100%); }
    50% { transform: translateX(200%); }
    100% { transform: translateX(200%); }
}

/* =========================
   CUSTOM CURSOR
   ========================= */

.cursor {
    position: fixed;
    top: 0;
    left: 0;
    pointer-events: none;
    z-index: 6000;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    opacity: 0;
    transition: width 0.25s ease, height 0.25s ease, opacity 0.25s ease, background 0.25s ease;
}

.cursor-dot {
    width: 8px;
    height: 8px;
    background: rgba(212,175,55,0.95);
}

.cursor-ring {
    width: 36px;
    height: 36px;
    border: 1px solid rgba(212,175,55,0.5);
    background: rgba(212,175,55,0.04);
}

body.cursor-active .cursor {
    opacity: 1;
}

/* =========================
   SECTION STYLES
   ========================= */

section {
    padding: 100px 8%;
    position: relative;
}

.section-title {
    text-align: center;
    margin-bottom: 60px;
}

.section-title h2 {
    color: var(--gold);
    margin-bottom: 16px;
    font-size: 42px;
}

.section-title p {
    color: var(--light-gray);
    max-width: 600px;
    margin: 0 auto;
    font-size: 16px;
}

/* =========================
   HEADER & NAVBAR
   ========================= */

header {
    position: fixed;
    top: 0;
    width: 100%;
    z-index: 1000;
    background: rgba(12, 12, 12, 0.18);
    backdrop-filter: blur(0px);
    border-bottom: 1px solid transparent;
    transition: background 0.5s ease, border-color 0.5s ease, backdrop-filter 0.5s ease, box-shadow 0.5s ease;
}

header.scrolled {
    background: rgba(12, 12, 12, 0.8);
    backdrop-filter: blur(14px);
    border-bottom-color: rgba(212, 175, 55, 0.18);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
}

.navbar {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 18px 40px;
    position: relative;
    z-index: 1;
}

.logo h2 {
    font-family: var(--font-heading);
    color: var(--gold);
    font-size: 28px;
    letter-spacing: 3px;
    font-weight: 700;
}

.logo p {
    font-size: 11px;
    letter-spacing: 4px;
    color: var(--light-gray);
    margin-top: -4px;
}

.nav-links {
    display: flex;
    list-style: none;
    gap: 32px;
}

.nav-links a {
    color: var(--white);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.5px;
    position: relative;
    padding: 6px 0;
}

.nav-links a::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--gold);
    transition: width 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.nav-links a:hover::after,
.nav-links a.active::after {
    width: 100%;
}

.nav-links a:hover,
.nav-links a.active {
    color: var(--gold);
}

.nav-icons {
    display: flex;
    gap: 20px;
    align-items: center;
}

.nav-icons i {
    color: var(--white);
    font-size: 18px;
    cursor: pointer;
    transition: 0.3s ease;
}

.nav-icons i:hover {
    color: var(--gold);
}

.icon {
    position: relative;
    display: inline-flex;
}

.icon span {
    position: absolute;
    top: -8px;
    right: -10px;
    background: var(--gold);
    color: var(--black);
    border-radius: 50%;
    font-size: 10px;
    font-weight: 700;
    padding: 2px 6px;
    min-width: 18px;
    text-align: center;
}

/* Mobile Menu */
.hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    cursor: pointer;
}

.hamburger span {
    width: 25px;
    height: 2px;
    background: var(--white);
    transition: 0.3s ease;
}

/* =========================
   HERO SECTION
   ========================= */

.hero {
    min-height: 100vh;
    background:
        linear-gradient(120deg, rgba(12, 12, 12, 0.94), rgba(12, 12, 12, 0.7)),
        url(" Images/Perfume.jpg\) center / cover no-repeat;
 display: flex;
 align-items: center;
 padding: 120px 8% 80px;
 position: relative;
 overflow: hidden;
 isolation: isolate;
}

.hero::before,
.hero::after {
 content: \\;
 position: absolute;
 border-radius: 50%;
 filter: blur(80px);
 opacity: 0.45;
 pointer-events: none;
}

.hero::before {
 width: 360px;
 height: 360px;
 background: rgba(212, 175, 55, 0.12);
 top: 8%;
 right: 8%;
}

.hero::after {
 width: 420px;
 height: 420px;
 background: rgba(247, 243, 238, 0.04);
 bottom: -14%;
 left: -8%;
}

.hero-content {
 display: flex;
 align-items: center;
 justify-content: space-between;
 gap: 60px;
 width: 100%;
 max-width: 1400px;
 margin: 0 auto;
}

.hero-text {
 flex: 1;
 max-width: 600px;
 position: relative;
 z-index: 1;
}

.hero-kicker {
 color: var(--gold);
 font-size: 13px;
 letter-spacing: 4px;
 text-transform: uppercase;
 margin-bottom: 16px;
 font-weight: 600;
}

.hero-text h1 {
 font-family: var(--font-heading);
 font-size: 72px;
 color: var(--white);
 margin-bottom: 24px;
 line-height: 1.1;
}

.hero-text h1 span {
 color: var(--gold);
 display: block;
 text-shadow: 0 8px 24px rgba(212, 175, 55, 0.2);
 letter-spacing: 1px;
}

.hero-text p {
 font-size: 18px;
 color: var(--light-gray);
 margin-bottom: 32px;
 max-width: 480px;
 line-height: 1.8;
}

.hero-text .btn {
 margin-bottom: 16px;
}

.hero-subtitle {
 font-size: 13px;
 color: var(--gold);
 letter-spacing: 2px;
 text-transform: uppercase;
}

.hero-visual {
 position: relative;
 flex: 1;
 display: flex;
 align-items: center;
 justify-content: center;
 min-height: 500px;
 perspective: 1400px;
 transform-style: preserve-3d;
}

.hero-glow {
 position: absolute;
 width: 460px;
 height: 460px;
 border-radius: 50%;
 background: radial-gradient(circle, rgba(212, 175, 55, 0.2), rgba(212, 175, 55, 0.08) 28%, transparent 70%);
 filter: blur(18px);
 z-index: 0;
}

.hero-bottle-wrap {
 position: relative;
 z-index: 2;
 transform-style: preserve-3d;
 transition: transform 0.2s ease-out;
}

.hero-bottle {
 width: min(520px, 42vw);
 max-height: 580px;
 object-fit: contain;
 filter: drop-shadow(0 24px 45px rgba(0, 0, 0, 0.6));
 animation: float 6s ease-in-out infinite;
 transform: rotateX(8deg) rotateY(-10deg);
}

.hero-orbit {
 position: absolute;
 inset: 5% auto auto 50%;
 width: 300px;
 height: 300px;
 transform: translateX(-50%);
 border-radius: 50%;
 z-index: 1;
}

.orbit-ring {
 position: absolute;
 inset: 0;
 border-radius: 50%;
 border: 1px solid rgba(212, 175, 55, 0.35);
 box-shadow: inset 0 0 20px rgba(212, 175, 55, 0.1);
 animation: spin 18s linear infinite;
}

.orbit-ring::before,
.orbit-ring::after {
 content: \\;
 position: absolute;
 width: 10px;
 height: 10px;
 border-radius: 50%;
 background: var(--gold);
 top: 15px;
 left: 50%;
 transform: translateX(-50%);
}

.orbit-ring::after {
 top: auto;
 bottom: 18px;
 left: 30%;
 background: var(--ivory);
}

.orbit-label {
 position: absolute;
 inset: 0;
 display: flex;
 align-items: center;
 justify-content: center;
 font-size: 10px;
 letter-spacing: 4px;
 color: rgba(255,255,255,0.75);
 text-transform: uppercase;
 transform: rotate(18deg);
}

.hero-actions {
 display: flex;
 align-items: center;
 gap: 18px;
 margin-top: 10px;
 flex-wrap: wrap;
}

.hero-details {
 display: flex;
 align-items: center;
 gap: 18px;
 margin-top: 22px;
 flex-wrap: wrap;
}

.hero-details .hero-subtitle {
 margin: 0;
 position: relative;
 padding-left: 16px;
}

.hero-details .hero-subtitle::before {
 content: \\;
 position: absolute;
 left: 0;
 top: 50%;
 width: 8px;
 height: 8px;
 border-radius: 50%;
 background: var(--gold);
 transform: translateY(-50%);
}

.hero-details span {
 color: var(--white);
 font-size: 14px;
 letter-spacing: 0.5px;
}

.hero-particles {
 position: absolute;
 inset: 0;
 pointer-events: none;
 z-index: 0;
}

.particle {
 position: absolute;
 width: 4px;
 height: 4px;
 border-radius: 50%;
 background: rgba(255,255,255,0.7);
 box-shadow: 0 0 14px rgba(212, 175, 55, 0.3);
 animation: drift 16s ease-in-out infinite alternate;
}

.particle-1 { top: 18%; left: 18%; }
.particle-2 { top: 28%; right: 22%; animation-delay: 1s; }
.particle-3 { top: 46%; left: 42%; animation-delay: 2.5s; }
.particle-4 { bottom: 24%; left: 28%; animation-delay: 1.8s; }
.particle-5 { bottom: 18%; right: 32%; animation-delay: 3s; }
.particle-6 { top: 16%; right: 36%; animation-delay: 2.2s; }
.particle-7 { top: 60%; left: 8%; animation-delay: 1.6s; }
.particle-8 { bottom: 40%; right: 10%; animation-delay: 3s; }

@keyframes float {
 0%, 100% { transform: translateY(0px) rotateX(8deg) rotateY(-10deg); }
 50% { transform: translateY(-20px) rotateX(10deg) rotateY(-6deg); }
}

@keyframes spin {
 0% { transform: rotate(0deg); }
 100% { transform: rotate(360deg); }
}

@keyframes drift {
 0% { transform: translate3d(0, 0, 0) scale(0.9); opacity: 0.35; }
 100% { transform: translate3d(10px, -22px, 0) scale(1.3); opacity: 1; }
}

/* =========================
   PRODUCTS GRID
   ========================= */

.products,
.category-container,
.testimonial-container {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    gap: 30px;
}

.products {
    grid-template-columns: repeat(4, minmax(0, 1fr));
}

.category-container {
    grid-template-columns: repeat(4, minmax(0, 1fr));
}

.testimonial-container {
    grid-template-columns: repeat(3, minmax(0, 1fr));
}

.best-sellers .products {
    grid-template-columns: repeat(3, minmax(0, 1fr));
}

/* =========================
   PRODUCT CARDS
   ========================= */

.product-card {
    background: rgba(23, 23, 22, 0.88);
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 24px;
    padding: 24px;
    text-align: center;
    transition: all 0.35s ease;
    position: relative;
    overflow: hidden;
    box-shadow: var(--shadow-soft);
}

.product-card::before {
    content: " \;
 position: absolute;
 inset: 0 auto auto 0;
 width: 100%;
 height: 1px;
 background: linear-gradient(90deg, transparent, rgba(212, 175, 55, 0.75), transparent);
 opacity: 0;
 transition: opacity 0.35s ease;
}

.product-card:hover {
 transform: translateY(-10px);
 box-shadow: var(--shadow-gold);
 border-color: rgba(212, 175, 55, 0.5);
}

.product-card:hover::before {
 opacity: 1;
}

.product-card .product-image {
 height: 220px;
 display: flex;
 align-items: center;
 justify-content: center;
 margin-bottom: 20px;
 overflow: hidden;
 border-radius: 18px;
 background: radial-gradient(circle at top, rgba(212,175,55,0.1), rgba(255,255,255,0.01) 60%);
 border: 1px solid rgba(255,255,255,0.04);
}

.product-card .product-image img {
 max-height: 180px;
 transition: transform 0.5s ease, filter 0.3s ease;
 filter: drop-shadow(0 18px 24px rgba(0, 0, 0, 0.42));
 transform: rotateX(8deg) rotateY(-8deg);
}

.product-card:hover .product-image img {
 transform: translateY(-8px) scale(1.08) rotateX(0) rotateY(0);
 filter: drop-shadow(0 26px 30px rgba(0,0,0,0.5));
}

.product-card h3 {
 font-family: var(--font-heading);
 color: var(--white);
 font-size: 20px;
 margin-bottom: 4px;
}

.product-card .brand {
 font-size: 12px;
 color: var(--gold);
 letter-spacing: 2px;
 text-transform: uppercase;
 margin-bottom: 4px;
}

.product-card .size {
 font-size: 13px;
 color: var(--light-gray);
 margin-bottom: 8px;
}

.product-card .rating {
 color: var(--gold);
 margin: 8px 0;
 font-size: 14px;
}

.product-card .rating span {
 color: var(--light-gray);
 margin-left: 6px;
 font-size: 13px;
}

.product-card h4 {
 color: var(--white);
 font-size: 22px;
 margin: 12px 0;
 font-weight: 600;
}

.product-card .cart-btn {
 background: linear-gradient(135deg, var(--gold), var(--light-gold));
 color: var(--black);
 border: none;
 padding: 10px 24px;
 border-radius: 25px;
 font-weight: 600;
 font-size: 13px;
 cursor: pointer;
 transition: all 0.3s ease;
 text-transform: uppercase;
 letter-spacing: 0.5px;
 margin-top: 8px;
 opacity: 0;
 transform: translateY(10px);
}

.product-card:hover .cart-btn {
 opacity: 1;
 transform: translateY(0);
}

.product-card .cart-btn:hover {
 background: var(--light-gold);
 transform: translateY(-2px);
}

/* Wishlist Heart */
.wishlist-btn {
 position: absolute;
 top: 32px;
 right: 32px;
 background: none;
 border: none;
 color: var(--light-gray);
 font-size: 18px;
 cursor: pointer;
 transition: 0.3s ease;
 z-index: 2;
}

.wishlist-btn:hover,
.wishlist-btn.active {
 color: #e74c3c;
}

/* =========================
   CATEGORY CARDS
   ========================= */

.category-card {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    height: 320px;
    cursor: pointer;
    transition: all 0.4s ease;
    border: 1px solid rgba(255,255,255,0.06);
    box-shadow: var(--shadow-soft);
}

.category-card:hover {
    transform: translateY(-8px);
    box-shadow: var(--shadow-gold);
}

.category-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s ease, filter 0.4s ease;
    filter: saturate(0.8);
}

.category-card:hover img {
    transform: scale(1.12);
    filter: saturate(1);
}

.category-card .category-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(11, 11, 11, 0.92) 10%, rgba(11,11,11,0.22) 58%, rgba(11,11,11,0.05) 100%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 28px;
}

.category-index {
    display: inline-block;
    color: rgba(255,255,255,0.65);
    letter-spacing: 3px;
    font-size: 12px;
    margin-bottom: 12px;
}

.category-card h3 {
    font-family: var(--font-heading);
    color: var(--white);
    font-size: 24px;
    margin-bottom: 8px;
    transition: transform 0.35s ease;
}

.category-card a {
    color: var(--gold);
    font-size: 14px;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    width: fit-content;
    position: relative;
}

.category-card a::before {
    content: " \;
 position: absolute;
 left: 0;
 bottom: -6px;
 width: 100%;
 height: 1px;
 background: rgba(212, 175, 55, 0.75);
 transform: scaleX(0);
 transform-origin: left;
 transition: transform 0.35s ease;
}

.category-card:hover h3,
.category-card:hover a {
 transform: translateY(-4px);
}

.category-card:hover a::before {
 transform: scaleX(1);
}

.category-card a:hover {
 gap: 12px;
}

/* =========================
 BEST SELLERS
 ========================= */

.best-card {
 position: relative;
 background: rgba(23, 23, 22, 0.9);
 border: 1px solid rgba(255,255,255,0.06);
 border-radius: 24px;
 padding: 0;
 text-align: left;
 transition: all 0.35s ease;
 overflow: hidden;
 box-shadow: var(--shadow-soft);
}

.best-card:hover {
 transform: translateY(-10px);
 box-shadow: var(--shadow-gold);
}

.best-card .badge {
 position: absolute;
 top: 16px;
 left: 16px;
 background: var(--gold);
 color: var(--black);
 padding: 6px 14px;
 border-radius: 20px;
 font-size: 12px;
 font-weight: 700;
 letter-spacing: 1px;
 z-index: 2;
}

.best-card img {
 width: 100%;
 height: 260px;
 object-fit: cover;
}

.best-card .best-content {
 padding: 24px;
}

.best-card h3 {
 font-family: var(--font-heading);
 color: var(--white);
 font-size: 22px;
 margin-bottom: 8px;
}

.best-card p {
 font-size: 14px;
 color: var(--light-gray);
 margin-bottom: 12px;
 line-height: 1.6;
}

.best-card .rating {
 color: var(--gold);
 font-size: 14px;
 margin-bottom: 16px;
}

.best-card .rating span {
 color: var(--light-gray);
 margin-left: 6px;
}

.best-card .price {
 display: flex;
 justify-content: space-between;
 align-items: center;
}

.best-card .price h4 {
 color: var(--white);
 font-size: 22px;
 font-weight: 600;
}

.best-card .price button {
 background: var(--gold);
 color: var(--black);
 border: none;
 padding: 10px 20px;
 border-radius: 25px;
 font-weight: 600;
 font-size: 13px;
 cursor: pointer;
 transition: all 0.3s ease;
 text-transform: uppercase;
}

.best-card .price button:hover {
 background: var(--light-gold);
}

/* =========================
   TESTIMONIALS
   ========================= */

.testimonial-slider {
    max-width: 1400px;
    margin: 0 auto;
    overflow: hidden;
    position: relative;
}

.testimonial-track {
    display: flex;
    transition: transform 0.6s ease;
    gap: 30px;
}

.testimonial-dots {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-top: 26px;
}

.testimonial-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: rgba(255,255,255,0.2);
    border: none;
    cursor: pointer;
    transition: all 0.3s ease;
}

.testimonial-dot.active {
    width: 28px;
    border-radius: 999px;
    background: var(--gold);
}

.testimonial-card {
    background: rgba(23, 23, 22, 0.9);
    color: var(--white);
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 24px;
    padding: 40px 32px;
    text-align: center;
    transition: all 0.35s ease;
    min-height: 100%;
    flex: 0 0 100%;
}

.testimonial-card:hover {
    transform: translateY(-8px);
    box-shadow: var(--shadow-gold);
    border-color: rgba(212, 175, 55, 0.5);
}

.testimonial-card .quote-icon {
    font-size: 48px;
    color: var(--gold);
    margin-bottom: 20px;
    font-family: var(--font-heading);
    line-height: 1;
    opacity: 0.9;
}

.testimonial-card p {
    color: var(--light-gray);
    font-size: 15px;
    line-height: 1.8;
    margin-bottom: 24px;
    font-style: italic;
}

.testimonial-card h3 {
    font-family: var(--font-heading);
    color: var(--white);
    font-size: 18px;
    margin-bottom: 4px;
}

.testimonial-card span {
    font-size: 13px;
    color: var(--light-gray);
}

.testimonial-card .stars {
    color: var(--gold);
    margin-bottom: 16px;
    font-size: 16px;
}

/* =========================
   NEWSLETTER
   ========================= */

.newsletter {
    background: linear-gradient(180deg, rgba(18,18,18,0.96), rgba(12,12,12,0.98));
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    text-align: center;
    padding: 80px 8%;
    position: relative;
}

.newsletter::before {
    content: " \;
 position: absolute;
 inset: 20px 10%; auto;
 height: 1px;
 background: linear-gradient(90deg, transparent, rgba(212,175,55,0.6), transparent);
}

.newsletter h2 {
 color: var(--gold);
 margin-bottom: 16px;
 font-size: 36px;
}

.newsletter p {
 margin-bottom: 32px;
 color: var(--light-gray);
}

.newsletter-form {
 display: flex;
 max-width: 500px;
 margin: 0 auto;
 gap: 12px;
}

.newsletter-form input {
 flex: 1;
 padding: 14px 20px;
 border: 1px solid var(--dark-gray);
 border-radius: 30px;
 background: var(--card-black);
 color: var(--white);
 font-family: var(--font-body);
 font-size: 14px;
 outline: none;
 transition: 0.3s ease;
}

.newsletter-form input:focus {
 border-color: var(--gold);
}

.newsletter-form button {
 background: var(--gold);
 color: var(--black);
 border: none;
 padding: 14px 32px;
 border-radius: 30px;
 font-weight: 600;
 font-size: 14px;
 cursor: pointer;
 transition: all 0.3s ease;
 text-transform: uppercase;
 letter-spacing: 1px;
 white-space: nowrap;
}

.newsletter-form button:hover {
 background: var(--light-gold);
}

/* =========================
   FOOTER
   ========================= */

footer {
    background: var(--black);
    border-top: 1px solid var(--dark-gray);
    padding: 80px 8% 30px;
}

.footer-content {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 60px;
    margin-bottom: 60px;
}

.footer-brand .logo h2 {
    font-family: var(--font-heading);
    color: var(--gold);
    font-size: 26px;
    letter-spacing: 3px;
    margin-bottom: 12px;
}

.footer-brand p {
    color: var(--light-gray);
    font-size: 14px;
    line-height: 1.8;
    max-width: 300px;
}

.footer-links h4 {
    font-family: var(--font-heading);
    color: var(--white);
    font-size: 18px;
    margin-bottom: 20px;
}

.footer-links ul li {
    margin-bottom: 12px;
}

.footer-links ul li a {
    color: var(--light-gray);
    font-size: 14px;
}

.footer-links ul li a:hover {
    color: var(--gold);
    padding-left: 6px;
}

.social-icons {
    display: flex;
    gap: 16px;
    margin-top: 20px;
}

.social-icons a {
    width: 42px;
    height: 42px;
    border: 1px solid var(--dark-gray);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--white);
    font-size: 16px;
    transition: all 0.3s ease;
}

.social-icons a:hover {
    background: var(--gold);
    color: var(--black);
    border-color: var(--gold);
    transform: translateY(-3px);
}

.payment-icons {
    display: flex;
    gap: 12px;
    margin-top: 20px;
    flex-wrap: wrap;
}

.payment-icons i {
    font-size: 28px;
    color: var(--light-gray);
    transition: 0.3s ease;
}

.payment-icons i:hover {
    color: var(--gold);
}

.footer-bottom {
    max-width: 1400px;
    margin: 0 auto;
    text-align: center;
    padding-top: 30px;
    border-top: 1px solid var(--dark-gray);
    color: #666;
    font-size: 13px;
}

/* =========================
   SHOP PAGE
   ========================= */

.shop-hero {
    background: linear-gradient(rgba(11, 11, 11, 0.8), rgba(11, 11, 11, 0.85)),
                url(" images/hero-bg.jpg\) center / cover;
 padding: 160px 8% 100px;
 text-align: center;
}

.shop-hero h1 {
 color: var(--gold);
 font-size: 56px;
 margin-bottom: 16px;
}

.shop-hero p {
 color: var(--light-gray);
 font-size: 18px;
}

.shop-filters {
 max-width: 1400px;
 margin: 0 auto;
 padding: 40px 8%;
 display: flex;
 flex-wrap: wrap;
 gap: 20px;
 align-items: center;
 justify-content: space-between;
}

.filter-buttons {
 display: flex;
 gap: 12px;
 flex-wrap: wrap;
}

.filter-btn {
 background: var(--card-black);
 color: var(--white);
 border: 1px solid var(--dark-gray);
 padding: 10px 24px;
 border-radius: 25px;
 font-family: var(--font-body);
 font-size: 13px;
 cursor: pointer;
 transition: all 0.3s ease;
 text-transform: uppercase;
 letter-spacing: 0.5px;
}

.filter-btn:hover,
.filter-btn.active {
 background: var(--gold);
 color: var(--black);
 border-color: var(--gold);
}

.search-box {
 position: relative;
}

.search-box input {
 padding: 10px 40px 10px 18px;
 border: 1px solid var(--dark-gray);
 border-radius: 25px;
 background: var(--card-black);
 color: var(--white);
 font-family: var(--font-body);
 font-size: 14px;
 width: 260px;
 outline: none;
 transition: 0.3s ease;
}

.search-box input:focus {
 border-color: var(--gold);
 width: 300px;
}

.search-box i {
 position: absolute;
 right: 14px;
 top: 50%;
 transform: translateY(-50%);
 color: var(--light-gray);
 font-size: 14px;
}

.products-grid {
 max-width: 1400px;
 margin: 0 auto;
 padding: 0 8% 100px;
 display: grid;
 grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
 gap: 30px;
}

.no-products {
 text-align: center;
 padding: 80px 20px;
 grid-column: 1 / -1;
}

.no-products i {
 font-size: 64px;
 color: var(--dark-gray);
 margin-bottom: 20px;
}

.no-products h3 {
 color: var(--light-gray);
 margin-bottom: 8px;
}

/* =========================
 COLLECTIONS PAGE
 ========================= */

.collections-hero {
 background: linear-gradient(rgba(11, 11, 11, 0.8), rgba(11, 11, 11, 0.85)),
 url(\images/hero-bg.jpg\) center / cover;
 padding: 160px 8% 100px;
 text-align: center;
}

.collections-hero h1 {
 color: var(--gold);
 font-size: 56px;
 margin-bottom: 16px;
}

.collections-hero p {
 color: var(--light-gray);
 font-size: 18px;
}

.collection-section {
 max-width: 1400px;
 margin: 0 auto;
 padding: 80px 8%;
 display: grid;
 grid-template-columns: 1fr 1fr;
 gap: 60px;
 align-items: center;
}

.collection-section.reverse {
 direction: rtl;
}

.collection-section.reverse .collection-text {
 direction: ltr;
}

.collection-image {
 border-radius: 20px;
 overflow: hidden;
 height: 450px;
 box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
}

.collection-image img {
 width: 100%;
 height: 100%;
 object-fit: cover;
 transition: transform 0.6s ease;
}

.collection-section:hover .collection-image img {
 transform: scale(1.05);
}

.collection-text h2 {
 color: var(--gold);
 font-size: 42px;
 margin-bottom: 20px;
}

.collection-text p {
 color: var(--light-gray);
 font-size: 16px;
 line-height: 1.8;
 margin-bottom: 28px;
}

/* =========================
   ABOUT PAGE
   ========================= */

.about-hero {
    background: linear-gradient(rgba(11, 11, 11, 0.8), rgba(11, 11, 11, 0.85)),
                url(" images/about.jpg\) center / cover;
 padding: 160px 8% 100px;
 text-align: center;
}

.about-hero h1 {
 color: var(--gold);
 font-size: 56px;
 margin-bottom: 16px;
}

.about-hero p {
 color: var(--light-gray);
 font-size: 18px;
}

.about-story {
 max-width: 900px;
 margin: 0 auto;
 padding: 80px 8%;
 text-align: center;
}

.about-story h2 {
 color: var(--gold);
 font-size: 42px;
 margin-bottom: 24px;
}

.about-story p {
 color: var(--light-gray);
 font-size: 16px;
 line-height: 1.9;
 margin-bottom: 20px;
}

.philosophy-cards {
 max-width: 1400px;
 margin: 0 auto;
 padding: 0 8% 100px;
 display: grid;
 grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
 gap: 30px;
}

.philosophy-card {
 background: var(--card-black);
 border: 1px solid var(--dark-gray);
 border-radius: 20px;
 padding: 40px 32px;
 text-align: center;
 transition: all 0.35s ease;
}

.philosophy-card:hover {
 transform: translateY(-8px);
 border-color: var(--gold);
 box-shadow: 0 20px 40px rgba(212, 175, 55, 0.1);
}

.philosophy-card i {
 font-size: 48px;
 color: var(--gold);
 margin-bottom: 20px;
}

.philosophy-card h3 {
 color: var(--white);
 font-size: 22px;
 margin-bottom: 12px;
}

.philosophy-card p {
 color: var(--light-gray);
 font-size: 14px;
 line-height: 1.7;
}

.stats-section {
 background: var(--dark-black);
 border-top: 1px solid var(--dark-gray);
 border-bottom: 1px solid var(--dark-gray);
 padding: 80px 8%;
}

.stats-grid {
 max-width: 1400px;
 margin: 0 auto;
 display: grid;
 grid-template-columns: repeat(4, 1fr);
 gap: 40px;
 text-align: center;
}

.stat-item h3 {
 color: var(--gold);
 font-size: 48px;
 margin-bottom: 8px;
}

.stat-item p {
 color: var(--light-gray);
 font-size: 14px;
 text-transform: uppercase;
 letter-spacing: 1px;
}

/* =========================
 CONTACT PAGE
 ========================= */

.contact-hero {
 background: linear-gradient(rgba(11, 11, 11, 0.8), rgba(11, 11, 11, 0.85)),
 url(\images/contact.jpg\) center / cover;
 padding: 160px 8% 100px;
 text-align: center;
}

.contact-hero h1 {
 color: var(--gold);
 font-size: 56px;
 margin-bottom: 16px;
}

.contact-hero p {
 color: var(--light-gray);
 font-size: 18px;
}

.contact-container {
 max-width: 1400px;
 margin: 0 auto;
 padding: 80px 8%;
 display: grid;
 grid-template-columns: 1fr 1fr;
 gap: 60px;
}

.contact-info h2 {
 color: var(--gold);
 font-size: 36px;
 margin-bottom: 24px;
}

.contact-info p {
 color: var(--light-gray);
 margin-bottom: 32px;
 line-height: 1.8;
}

.info-item {
 display: flex;
 gap: 16px;
 margin-bottom: 24px;
 align-items: flex-start;
}

.info-item i {
 color: var(--gold);
 font-size: 20px;
 margin-top: 4px;
}

.info-item h4 {
 color: var(--white);
 font-size: 16px;
 margin-bottom: 4px;
 font-family: var(--font-body);
 font-weight: 600;
}

.info-item p {
 color: var(--light-gray);
 font-size: 14px;
 margin: 0;
}

.contact-form {
 background: var(--card-black);
 border: 1px solid var(--dark-gray);
 border-radius: 20px;
 padding: 40px;
}

.contact-form h2 {
 color: var(--gold);
 font-size: 28px;
 margin-bottom: 24px;
}

.form-group {
 margin-bottom: 20px;
}

.form-group label {
 display: block;
 color: var(--light-gray);
 font-size: 13px;
 margin-bottom: 8px;
 font-weight: 500;
 text-transform: uppercase;
 letter-spacing: 0.5px;
}

.form-group input,
.form-group textarea {
 width: 100%;
 padding: 14px 18px;
 border: 1px solid var(--dark-gray);
 border-radius: 12px;
 background: var(--black);
 color: var(--white);
 font-family: var(--font-body);
 font-size: 14px;
 outline: none;
 transition: 0.3s ease;
}

.form-group input:focus,
.form-group textarea:focus {
 border-color: var(--gold);
}

.form-group textarea {
 min-height: 140px;
 resize: vertical;
}

.contact-form .btn {
 width: 100%;
 padding: 16px;
 font-size: 15px;
}

.form-message {
 display: none;
 background: rgba(212, 175, 55, 0.1);
 border: 1px solid var(--gold);
 color: var(--gold);
 padding: 16px;
 border-radius: 12px;
 text-align: center;
 margin-top: 20px;
 font-weight: 500;
}

/* =========================
   CART SIDEBAR
   ========================= */

.cart-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    z-index: 2000;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s ease;
}

.cart-overlay.active {
    opacity: 1;
    visibility: visible;
}

.cart-sidebar {
    position: fixed;
    top: 0;
    right: -420px;
    width: 400px;
    max-width: 90vw;
    height: 100vh;
    background: var(--card-black);
    z-index: 2001;
    transition: right 0.4s ease;
    display: flex;
    flex-direction: column;
    border-left: 1px solid var(--dark-gray);
}

.cart-sidebar.active {
    right: 0;
}

.cart-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 24px;
    border-bottom: 1px solid var(--dark-gray);
}

.cart-header h3 {
    font-family: var(--font-heading);
    color: var(--gold);
    font-size: 22px;
}

.close-cart {
    background: none;
    border: none;
    color: var(--white);
    font-size: 24px;
    cursor: pointer;
    transition: 0.3s ease;
}

.close-cart:hover {
    color: var(--gold);
}

.cart-items {
    flex: 1;
    overflow-y: auto;
    padding: 24px;
}

.cart-item {
    display: flex;
    gap: 16px;
    padding: 16px 0;
    border-bottom: 1px solid var(--dark-gray);
}

.cart-item img {
    width: 70px;
    height: 70px;
    object-fit: cover;
    border-radius: 12px;
    background: var(--black);
}

.cart-item-info {
    flex: 1;
}

.cart-item-info h4 {
    color: var(--white);
    font-size: 14px;
    font-family: var(--font-body);
    font-weight: 600;
    margin-bottom: 4px;
}

.cart-item-info .cart-item-price {
    color: var(--gold);
    font-size: 14px;
    font-weight: 600;
}

.cart-item-info .cart-item-qty {
    color: var(--light-gray);
    font-size: 13px;
    margin-top: 4px;
}

.remove-item {
    background: none;
    border: none;
    color: #e74c3c;
    cursor: pointer;
    font-size: 16px;
    transition: 0.3s ease;
    align-self: flex-start;
}

.remove-item:hover {
    color: #c0392b;
}

.qty-btn {
    background: var(--card-black);
    border: 1px solid var(--dark-gray);
    color: var(--white);
    width: 28px;
    height: 28px;
    border-radius: 50%;
    cursor: pointer;
    font-size: 14px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    margin: 0 8px;
}

.qty-btn:hover {
    background: var(--gold);
    color: var(--black);
    border-color: var(--gold);
}

.cart-item-qty {
    display: flex;
    align-items: center;
    margin-top: 8px;
}

.cart-item-qty span {
    color: var(--white);
    font-weight: 600;
    min-width: 24px;
    text-align: center;
}

.cart-footer {
    padding: 24px;
    border-top: 1px solid var(--dark-gray);
}

.cart-total {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
}

.cart-total h4 {
    color: var(--white);
    font-size: 18px;
}

.cart-total span {
    color: var(--gold);
    font-size: 22px;
    font-weight: 700;
}

.cart-footer .btn {
    width: 100%;
    padding: 16px;
    font-size: 15px;
}

.cart-empty {
    text-align: center;
    padding: 60px 20px;
    color: var(--light-gray);
}

.cart-empty i {
    font-size: 64px;
    color: var(--dark-gray);
    margin-bottom: 20px;
    display: block;
}

/* =========================
   SEARCH OVERLAY
   ========================= */

.search-overlay {
    position: fixed;
    inset: 0;
    background: rgba(11, 11, 11, 0.95);
    z-index: 3000;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 120px;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s ease;
}

.search-overlay.active {
    opacity: 1;
    visibility: visible;
}

.search-container {
    width: 100%;
    max-width: 700px;
    padding: 0 20px;
}

.search-container input {
    width: 100%;
    padding: 18px 24px;
    border: none;
    border-bottom: 2px solid var(--gold);
    background: transparent;
    color: var(--white);
    font-family: var(--font-heading);
    font-size: 32px;
    outline: none;
}

.search-container input::placeholder {
    color: #666;
}

.close-search {
    position: absolute;
    top: 40px;
    right: 40px;
    background: none;
    border: none;
    color: var(--white);
    font-size: 32px;
    cursor: pointer;
    transition: 0.3s ease;
}

.close-search:hover {
    color: var(--gold);
}

/* =========================
   ANIMATIONS
   ========================= */

@keyframes fadeIn {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
}

.fade-in {
    animation: fadeIn 0.8s ease forwards;
}

/* =========================
   UTILITIES
   ========================= */

.text-gold { color: var(--gold); }
.text-center { text-align: center; }
.mb-20 { margin-bottom: 20px; }
.mb-40 { margin-bottom: 40px; }

.reveal {
    opacity: 0;
    transform: translateY(26px);
    transition: opacity 0.8s ease, transform 0.8s ease, filter 0.8s ease;
    will-change: transform, opacity;
}

.reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
}

.reveal-up {
    transform: translateY(26px);
}

.reveal-scale {
    transform: scale(0.96);
}

.reveal-scale.is-visible {
    transform: scale(1);
}

.reveal-blur {
    filter: blur(10px);
}

.reveal-blur.is-visible {
    filter: blur(0);
}

.magnetic-btn {
    transform: translate3d(0, 0, 0);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
}

/* =========================
   RESPONSIVE DESIGN
   ========================= */

/* Tablet - 1024px */
@media (max-width: 1024px) {
    .navbar {
        padding: 16px 24px;
    }

    .nav-links {
        gap: 20px;
    }

    .hero-content {
        gap: 40px;
    }

    .hero-text h1 {
        font-size: 56px;
    }

    .hero-bottle {
        width: min(420px, 52vw);
    }

    .products,
    .category-container,
    .best-sellers .products,
    .testimonial-container {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    section {
        padding: 80px 6%;
    }

    .section-title h2 {
        font-size: 36px;
    }

    .footer-content {
        grid-template-columns: 1fr 1fr;
        gap: 40px;
    }

    .collection-section {
        gap: 40px;
    }

    .collection-image {
        height: 350px;
    }

    .contact-container {
        gap: 40px;
    }

    .stats-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 30px;
    }
}

/* Tablet - 768px */
@media (max-width: 768px) {
    .navbar {
        flex-wrap: wrap;
        gap: 16px;
    }

    .hamburger {
        display: flex;
    }

    .nav-links {
        display: none;
        width: 100%;
        flex-direction: column;
        gap: 0;
        padding-top: 16px;
    }

    .nav-links.active {
        display: flex;
    }

    .nav-links li {
        border-top: 1px solid var(--dark-gray);
    }

    .nav-links a {
        display: block;
        padding: 14px 0;
    }

    .nav-icons {
        gap: 16px;
    }

    .hero {
        padding: 100px 6% 60px;
        min-height: auto;
    }

    .hero-content {
        flex-direction: column;
        text-align: center;
    }

    .hero-text {
        max-width: 100%;
    }

    .hero-text h1 {
        font-size: 42px;
    }

    .hero-text p {
        max-width: 100%;
        margin: 0 auto 28px;
    }

    .hero-image img {
        max-height: 350px;
    }

    .products-grid {
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 20px;
    }

    .shop-filters {
        flex-direction: column;
        align-items: stretch;
    }

    .filter-buttons {
        justify-content: center;
    }

    .search-box input {
        width: 100%;
    }

    .search-box input:focus {
        width: 100%;
    }

    .collection-section {
        grid-template-columns: 1fr;
    }

    .collection-section.reverse {
        direction: ltr;
    }

    .collection-image {
        height: 300px;
    }

    .contact-container {
        grid-template-columns: 1fr;
    }

    .footer-content {
        grid-template-columns: 1fr;
        gap: 40px;
    }
}

/* Mobile - 600px */
@media (max-width: 600px) {
    .hero-text h1 {
        font-size: 34px;
    }

    .hero-text p {
        font-size: 15px;
    }

    .section-title h2 {
        font-size: 28px;
    }

    .section-title p {
        font-size: 14px;
    }

    section {
        padding: 60px 5%;
    }

    .products-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 16px;
        padding: 0 5% 60px;
    }

    .product-card {
        padding: 16px;
    }

    .product-card .product-image {
        height: 160px;
    }

    .product-card .product-image img {
        max-height: 130px;
    }

    .product-card h3 {
        font-size: 16px;
    }

    .product-card h4 {
        font-size: 18px;
    }

    .product-card .cart-btn {
        padding: 8px 16px;
        font-size: 12px;
    }

    .category-card {
        height: 240px;
    }

    .category-card h3 {
        font-size: 20px;
    }

    .newsletter-form {
        flex-direction: column;
    }

    .newsletter h2 {
        font-size: 28px;
    }

    .shop-hero h1,
    .collections-hero h1,
    .about-hero h1,
    .contact-hero h1 {
        font-size: 36px;
    }

    .collection-text h2 {
        font-size: 32px;
    }

    .stats-grid {
        grid-template-columns: 1fr 1fr;
        gap: 24px;
    }

    .stat-item h3 {
        font-size: 36px;
    }

    .contact-form {
        padding: 24px;
    }

    .cart-sidebar {
        width: 100%;
        max-width: 100vw;
    }
}

/* Mobile - 375px */
@media (max-width: 375px) {
    .products-grid {
        grid-template-columns: 1fr;
    }

    .hero-text h1 {
        font-size: 30px;
    }

    .section-title h2 {
        font-size: 26px;
    }

    .filter-btn {
        padding: 8px 16px;
        font-size: 12px;
    }
}

/* =========================
   TESTIMONIAL ARROWS
   ========================= */

.testimonial-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(22, 22, 20, 0.6);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255,255,255,0.08);
    color: var(--white);
    width: 48px;
    height: 48px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    z-index: 2;
    font-size: 16px;
}

.testimonial-arrow:hover {
    background: var(--gold);
    color: var(--black);
    border-color: var(--gold);
    transform: translateY(-50%) scale(1.08);
}

.testimonial-prev {
    left: -20px;
}

.testimonial-next {
    right: -20px;
}

@media (max-width: 768px) {
    .testimonial-prev {
        left: 8px;
    }
    .testimonial-next {
        right: 8px;
    }
    .testimonial-arrow {
        width: 40px;
        height: 40px;
        font-size: 14px;
    }
}

/* =========================
   NOISE OVERLAY
   ========================= */

.noise-overlay {
    position: absolute;
    inset: 0;
    background-image: url(" data:image/svg+xml,%3Csvg viewBox=0 0 256 256 xmlns=http://www.w3.org/2000/svg%3E%3Cfilter id=noiseFilter%3E%3CfeTurbulence type=fractalNoise baseFrequency=0.85 numOctaves=4 stitchTiles=stitch/%3E%3C/filter%3E%3Crect width=100%25 height=100%25 filter=url(%23noiseFilter)/%3E%3C/svg%3E\);
 opacity: 0.04;
 pointer-events: none;
 z-index: 0;
}

/* =========================
 CURSOR GLOW
 ========================= */

.cursor-glow {
 position: fixed;
 top: 0;
 left: 0;
 width: 500px;
 height: 500px;
 border-radius: 50%;
 background: radial-gradient(circle, rgba(212,175,55,0.08), transparent 60%);
 pointer-events: none;
 z-index: 0;
 transform: translate(-50%, -50%);
 opacity: 0;
 transition: opacity 0.4s ease;
}

body.cursor-active .cursor-glow {
 opacity: 1;
}

/* =========================
 FILM GRAIN / NOISE
 ========================= */

body::after {
 content: \\;
 position: fixed;
 inset: 0;
 background-image: url(\data:image/svg+xml,%3Csvg viewBox=0 0 256 256 xmlns=http://www.w3.org/2000/svg%3E%3Cfilter id=noiseFilter%3E%3CfeTurbulence type=fractalNoise baseFrequency=0.85 numOctaves=4 stitchTiles=stitch/%3E%3C/filter%3E%3Crect width=100%25 height=100%25 filter=url(%23noiseFilter)/%3E%3C/svg%3E\);
 opacity: 0.03;
 pointer-events: none;
 z-index: 9998;
}
